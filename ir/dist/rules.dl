acs_req_0134__violation(Seq, Session, Method) :- hook(Seq, Session, Method), content_bearing_method(Method), !acs_req_0134__snapshot_before(Session, Seq).
// snapshot_before(Session, Seq) :- request(Snapshot, Session, "agbom/snapshot", _, _), hook(Seq, Session, _), Snapshot < Seq.
acs_req_0134__snapshot_before(Session, Seq) :- request(Snapshot, Session, "agbom/snapshot", _, _), hook(Seq, Session, _), Snapshot < Seq.

