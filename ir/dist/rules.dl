// ACS-REQ-0001: compiled
.decl acs_req_0001__violation(subject_seq:Seq, witness_path:JsonPath)
.output acs_req_0001__violation
// violation(Seq, Path) :- schema_violation(Seq, "response-envelope.json", Path).
acs_req_0001__violation(Seq, Path) :- schema_violation(Seq, "response-envelope.json", Path).

// ACS-REQ-0002: compiled
.decl acs_req_0002__rejected(c1:Seq)
.decl acs_req_0002__violation(subject_seq:Seq, witness_session:Session)
.output acs_req_0002__violation
// violation(Seq, Session) :- request(Seq, Session, _, _, _), array_input(Seq), session_batching(Session, "unsupported"), not rejected(Seq).
acs_req_0002__violation(Seq, Session) :- request(Seq, Session, _, _, _), array_input(Seq), session_batching(Session, "unsupported"), !acs_req_0002__rejected(Seq).
// rejected(Seq) :- response_to(Seq, R), error_code(R, -32600).
acs_req_0002__rejected(Seq) :- response_to(Seq, R), error_code(R, -32600).

// ACS-REQ-0003: compiled
.decl acs_req_0003__violation(subject_seq:Seq, witness_disposition:Disposition, witness_field:Field)
.output acs_req_0003__violation
// violation(Seq, Disposition, Field) :- decision(Seq, Disposition), required_field(Disposition, Field), not result_field(Seq, Field).
acs_req_0003__violation(Seq, Disposition, Field) :- decision(Seq, Disposition), required_field(Disposition, Field), !result_field(Seq, Field).

// ACS-REQ-0004: compiled
.decl acs_req_0004__violation(subject_seq:Seq, witness_field:Field)
.output acs_req_0004__violation
// violation(Seq, Field) :- decision(Seq, "defer"), defer_required(Field), not defer_field(Seq, Field).
acs_req_0004__violation(Seq, Field) :- decision(Seq, "defer"), defer_required(Field), !defer_field(Seq, Field).

// ACS-REQ-0005: compiled
.decl acs_req_0005__violation(subject_seq:Seq, witness_reason:Reason)
.output acs_req_0005__violation
// violation(Seq, Reason) :- defer_reason(Seq, Reason), not defer_reason_allowed(Reason).
acs_req_0005__violation(Seq, Reason) :- defer_reason(Seq, Reason), !defer_reason_allowed(Reason).

// ACS-REQ-0006: compiled
.decl acs_req_0006__defer_in(c1:Session, c2:Seq)
.decl acs_req_0006__violation(subject_session:Session, witness_deferrals:number, witness_bound:Bound)
.output acs_req_0006__violation
// violation(Session, Deferrals, Bound) :- defer_bound(Session, Bound), Deferrals = count : { defer_in(Session, _) }, Deferrals > Bound.
acs_req_0006__violation(Session, Deferrals, Bound) :- defer_bound(Session, Bound), Deferrals = count : { acs_req_0006__defer_in(Session, _) }, Deferrals > Bound.
// defer_in(Session, Seq) :- request(Q, Session, _, _, _), response_to(Q, Seq), decision(Seq, "defer").
acs_req_0006__defer_in(Session, Seq) :- request(Q, Session, _, _, _), response_to(Q, Seq), decision(Seq, "defer").

// ACS-REQ-0007: compiled
.decl acs_req_0007__handshake_before(c1:Session, c2:Seq)
.decl acs_req_0007__violation(subject_seq:Seq, witness_session:Session, witness_method:Method)
.output acs_req_0007__violation
// violation(Seq, Session, Method) :- hook(Seq, Session, Method), not handshake_before(Session, Seq).
acs_req_0007__violation(Seq, Session, Method) :- hook(Seq, Session, Method), !acs_req_0007__handshake_before(Session, Seq).
// handshake_before(Session, Seq) :- handshake(H, Session), hook(Seq, Session, _), H < Seq.
acs_req_0007__handshake_before(Session, Seq) :- handshake(H, Session), hook(Seq, Session, _), H < Seq.

// ACS-REQ-0008: compiled
.decl acs_req_0008__violation(subject_seq:Seq, witness_agentorder:Order, witness_deterministicorder:Order)
.output acs_req_0008__violation
// violation(Seq, AgentOrder, DeterministicOrder) :- evaluator_ran(Seq, "agent", AgentOrder), evaluator_ran(Seq, "deterministic", DeterministicOrder), AgentOrder < DeterministicOrder.
acs_req_0008__violation(Seq, AgentOrder, DeterministicOrder) :- evaluator_ran(Seq, "agent", AgentOrder), evaluator_ran(Seq, "deterministic", DeterministicOrder), AgentOrder < DeterministicOrder.

// ACS-REQ-0009: compiled
.decl acs_req_0009__seen_in_session(c1:Session, c2:Pid)
.decl acs_req_0009__violation(subject_seq:Seq, subject_pid:Pid, witness_parent:Pid)
.output acs_req_0009__violation
// violation(Seq, Pid, Parent) :- derived_from(Seq, Pid, Parent), provenance(Seq, Session, Pid, _), not seen_in_session(Session, Parent).
acs_req_0009__violation(Seq, Pid, Parent) :- derived_from(Seq, Pid, Parent), provenance(Seq, Session, Pid, _), !acs_req_0009__seen_in_session(Session, Parent).
// seen_in_session(Session, Pid) :- provenance(_, Session, Pid, _).
acs_req_0009__seen_in_session(Session, Pid) :- provenance(_, Session, Pid, _).

// ACS-REQ-0010: compiled
.decl acs_req_0010__ancestor(c1:Pid, c2:Pid)
.decl acs_req_0010__violation(subject_seq:Seq, subject_pid:Pid, witness_ancestor:Pid, witness_level:Level, witness_ancestorlevel:Level)
.output acs_req_0010__violation
// violation(Seq, Pid, Ancestor, Level, AncestorLevel) :- trust(Seq, Pid, Level), provenance(Seq, _, Pid, "agent_generated"), ancestor(Pid, Ancestor), trust(_, Ancestor, AncestorLevel), trust_rank(Level, Rank), trust_rank(AncestorLevel, AncestorRank), Rank > AncestorRank.
acs_req_0010__violation(Seq, Pid, Ancestor, Level, AncestorLevel) :- trust(Seq, Pid, Level), provenance(Seq, _, Pid, "agent_generated"), acs_req_0010__ancestor(Pid, Ancestor), trust(_, Ancestor, AncestorLevel), trust_rank(Level, Rank), trust_rank(AncestorLevel, AncestorRank), Rank > AncestorRank.
// ancestor(Pid, Parent) :- derived_from(_, Pid, Parent).
acs_req_0010__ancestor(Pid, Parent) :- derived_from(_, Pid, Parent).
// ancestor(Pid, Ancestor) :- derived_from(_, Pid, Parent), ancestor(Parent, Ancestor).
acs_req_0010__ancestor(Pid, Ancestor) :- derived_from(_, Pid, Parent), acs_req_0010__ancestor(Parent, Ancestor).

// ACS-REQ-0011: compiled
.decl acs_req_0011__violation(subject_session:Session, subject_seq:Seq, witness_capability:Capability)
.output acs_req_0011__violation
// violation(Session, Seq, Capability) :- intent_parsed(Session, Seq, Capability), intent_established(Session, Established), Seq > Established, not intent_parsed(Session, Established, Capability), not intent_extension(Session, _, Capability).
acs_req_0011__violation(Session, Seq, Capability) :- intent_parsed(Session, Seq, Capability), intent_established(Session, Established), Seq > Established, !intent_parsed(Session, Established, Capability), !intent_extension(Session, _, Capability).

// ACS-REQ-0012: compiled
.decl acs_req_0012__violation(subject_session:Session, witness_seq:Seq)
.output acs_req_0012__violation
// violation(Session, Seq) :- intent_modification_rejected(Session, Seq), not audit_event(Session, Seq, "intent_modification").
acs_req_0012__violation(Session, Seq) :- intent_modification_rejected(Session, Seq), !audit_event(Session, Seq, "intent_modification").

// ACS-REQ-0013: compiled
.decl acs_req_0013__violation(subject_session:Session, subject_entryid:EntryId, witness_claimed:EntryHash, witness_recomputed:EntryHash)
.output acs_req_0013__violation
// violation(Session, EntryId, Claimed, Recomputed) :- context_entry(Session, EntryId, _, Claimed), entry_hash_recomputed(EntryId, Recomputed), Claimed != Recomputed.
acs_req_0013__violation(Session, EntryId, Claimed, Recomputed) :- context_entry(Session, EntryId, _, Claimed), entry_hash_recomputed(EntryId, Recomputed), Claimed != Recomputed.

// ACS-REQ-0014: compiled
.decl acs_req_0014__violation(subject_session:Session, subject_pid:Pid, witness_firstfingerprint:Fingerprint, witness_secondfingerprint:Fingerprint)
.output acs_req_0014__violation
// violation(Session, Pid, FirstFingerprint, SecondFingerprint) :- provenance_fingerprint(Session, Pid, FirstFingerprint), provenance_fingerprint(Session, Pid, SecondFingerprint), FirstFingerprint != SecondFingerprint.
acs_req_0014__violation(Session, Pid, FirstFingerprint, SecondFingerprint) :- provenance_fingerprint(Session, Pid, FirstFingerprint), provenance_fingerprint(Session, Pid, SecondFingerprint), FirstFingerprint != SecondFingerprint.

// ACS-REQ-0015: compiled
.decl acs_req_0015__common_version(c1:Session)
.decl acs_req_0015__refused(c1:Seq)
.decl acs_req_0015__violation(subject_seq:Seq, witness_session:Session)
.output acs_req_0015__violation
// violation(Seq, Session) :- handshake(Seq, Session), not common_version(Session), not refused(Seq).
acs_req_0015__violation(Seq, Session) :- handshake(Seq, Session), !acs_req_0015__common_version(Session), !acs_req_0015__refused(Seq).
// common_version(Session) :- client_version(Session, Version), guardian_version(Version).
acs_req_0015__common_version(Session) :- client_version(Session, Version), guardian_version(Version).
// refused(Seq) :- response_to(Seq, R), error_code(R, -32001).
acs_req_0015__refused(Seq) :- response_to(Seq, R), error_code(R, -32001).

