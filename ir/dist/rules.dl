// violation(Seq, Summary, Detail) :- compaction_summary_provenance(Seq, Summary), provenance(Seq, _, Summary, Origin), Origin != "agent_generated", Detail = cat("origin=", Origin).
acs_req_0111__violation(Seq, Summary, Detail) :- compaction_summary_provenance(Seq, Summary), provenance(Seq, _, Summary, Origin), Origin != "agent_generated", Detail = cat("origin=", Origin).
// violation(Seq, Summary, Detail) :- compaction_summary_provenance(Seq, Summary), hook(Seq, Session, _), compaction_entry(Seq, StepId), step_provenance(Session, StepId, Pid), not derived_from(Seq, Summary, Pid), Detail = cat("missing=", Pid).
acs_req_0111__violation(Seq, Summary, Detail) :- compaction_summary_provenance(Seq, Summary), hook(Seq, Session, _), compaction_entry(Seq, StepId), step_provenance(Session, StepId, Pid), !derived_from(Seq, Summary, Pid), Detail = cat("missing=", Pid).

// ACS-REQ-0112: permission -- a MAY that was not exercised yields no verdict

// ACS-REQ-0113: compiled
.decl acs_req_0113__violation(subject_seq:Seq, witness_response:Seq)
.output acs_req_0113__violation
// violation(Seq, Response) :- request(Seq, _, "steps/postCompact", _, _), response_to(Seq, Response), decision(Response, "deny").
acs_req_0113__violation(Seq, Response) :- request(Seq, _, "steps/postCompact", _, _), response_to(Seq, Response), decision(Response, "deny").

// ACS-REQ-0114: compiled
.decl acs_req_0114__violation(subject_session:Session, subject_seq:Seq, witness_method:symbol)
.output acs_req_0114__violation
// violation(Session, Seq, "steps/postCompact") :- request(Seq, Session, "steps/postCompact", _, _), not context_entry(Session, _, Seq, _).
acs_req_0114__violation(Session, Seq, "steps/postCompact") :- request(Seq, Session, "steps/postCompact", _, _), !context_entry(Session, _, Seq, _).

// ACS-REQ-0116: permission -- a MAY that was not exercised yields no verdict

// ACS-REQ-0117: compiled
.decl acs_req_0117__approved_since(c1:Session, c2:SkillId, c3:Seq)
.decl acs_req_0117__violation(subject_loadseq:Seq, witness_session:Session, witness_skillid:SkillId)
.output acs_req_0117__violation
// violation(LoadSeq, Session, SkillId) :- skill_register(RegSeq, Session, SkillId, _), response_to(RegSeq, RR), decision(RR, "deny"), skill_load(LoadSeq, Session, SkillId, _), RegSeq < LoadSeq, response_to(LoadSeq, LR), decision(LR, "allow"), not approved_since(Session, SkillId, RegSeq).
acs_req_0117__violation(LoadSeq, Session, SkillId) :- skill_register(RegSeq, Session, SkillId, _), response_to(RegSeq, RR), decision(RR, "deny"), skill_load(LoadSeq, Session, SkillId, _), RegSeq < LoadSeq, response_to(LoadSeq, LR), decision(LR, "allow"), !acs_req_0117__approved_since(Session, SkillId, RegSeq).
// approved_since(Session, SkillId, RegSeq) :- skill_register(RegSeq, Session, SkillId, _), skill_register(Later, Session, SkillId, _), Later > RegSeq, response_to(Later, R), decision(R, "allow").
acs_req_0117__approved_since(Session, SkillId, RegSeq) :- skill_register(RegSeq, Session, SkillId, _), skill_register(Later, Session, SkillId, _), Later > RegSeq, response_to(Later, R), decision(R, "allow").

// ACS-REQ-0118: non-testable -- no trace can falsify it; listed on the non-testable roster

// ACS-REQ-0119: permission -- a MAY that was not exercised yields no verdict

// ACS-REQ-0120: compiled
.decl acs_req_0120__approved(c1:Session, c2:SkillId, c3:Digest)
.decl acs_req_0120__violation(subject_loadseq:Seq, witness_session:Session, witness_skillid:SkillId, witness_digest:Digest)
.output acs_req_0120__violation
// violation(LoadSeq, Session, SkillId, Digest) :- skill_load(LoadSeq, Session, SkillId, Digest), not approved(Session, SkillId, Digest).
acs_req_0120__violation(LoadSeq, Session, SkillId, Digest) :- skill_load(LoadSeq, Session, SkillId, Digest), !acs_req_0120__approved(Session, SkillId, Digest).
// approved(Session, SkillId, Digest) :- skill_register(RegSeq, Session, SkillId, Digest), response_to(RegSeq, R), decision(R, "allow").
acs_req_0120__approved(Session, SkillId, Digest) :- skill_register(RegSeq, Session, SkillId, Digest), response_to(RegSeq, R), decision(R, "allow").

// ACS-REQ-0121: compiled
.decl acs_req_0121__approved(c1:Session, c2:SkillId, c3:Digest)
.decl acs_req_0121__violation(subject_loadseq:Seq, witness_session:Session, witness_skillid:SkillId)
.output acs_req_0121__violation
// violation(LoadSeq, Session, SkillId) :- skill_load(LoadSeq, Session, SkillId, Digest), not approved(Session, SkillId, Digest), response_to(LoadSeq, R), decision(R, "allow").
acs_req_0121__violation(LoadSeq, Session, SkillId) :- skill_load(LoadSeq, Session, SkillId, Digest), !acs_req_0121__approved(Session, SkillId, Digest), response_to(LoadSeq, R), decision(R, "allow").
// approved(Session, SkillId, Digest) :- skill_register(RegSeq, Session, SkillId, Digest), response_to(RegSeq, RR), decision(RR, "allow").
acs_req_0121__approved(Session, SkillId, Digest) :- skill_register(RegSeq, Session, SkillId, Digest), response_to(RegSeq, RR), decision(RR, "allow").

