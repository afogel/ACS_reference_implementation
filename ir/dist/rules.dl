.decl acs_req_0130__violation(subject_session:Session, witness_componentid:ComponentId)
.output acs_req_0130__violation
// violation(Session, ComponentId) :- agbom_component(_, Session, "skill", ComponentId), not skill_hook_seen(Session).
acs_req_0130__violation(Session, ComponentId) :- agbom_component(_, Session, "skill", ComponentId), !acs_req_0130__skill_hook_seen(Session).
// skill_hook_seen(Session) :- hook(_, Session, "steps/skillRegister").
acs_req_0130__skill_hook_seen(Session) :- hook(_, Session, "steps/skillRegister").
